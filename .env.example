# ── LLM providers ───────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek            # deepseek | anthropic
LLM_MODEL=deepseek-chat          # model name when LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Supabase (Project Settings → API) ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # server-side ONLY. Never put this in the frontend/HF Space.

# ── Legal data APIs ─────────────────────────────────────────────────────────
GOVINFO_API_KEY=
COURTLISTENER_API_TOKEN=
CANLII_API_KEY=
CFR_YEAR=2024                    # annual CFR edition to ingest

# ── App config ──────────────────────────────────────────────────────────────
KEJI_ENV=development             # development | production
KEJI_API_SECRET=                 # long random string; shared by API and Streamlit
KEJI_REVIEWER_SECRET=            # a DIFFERENT long random string; only lawyers who approve outputs get it
KEJI_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=https://keji.legal,https://www.keji.legal   # extra CORS origins in production
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=5
